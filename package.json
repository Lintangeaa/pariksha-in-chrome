{
  "name": "pariksha-in-chrome",
  "version": "0.1.0",
  "description": "Pariksha Chrome extension (MV3) - records network/console/click interactions and uploads them as a structured RecordedSession",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && node esbuild.config.mjs && node scripts/copy-static.mjs",
    "build:zip": "node scripts/build-zip.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.13.1",
    "esbuild": "^0.24.2",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "preact": "^10.29.8"
  }
}
